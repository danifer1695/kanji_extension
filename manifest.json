{
    "manifest_version": 3,
    "name": "Shirabeyou",
    "version": "1.0.2",
    "description": "Instant kanji data lookup, storage and review for any Japanese-language text on the web.",
    "icons" : {
        "16": "assets/images/icons/icon_16.png",
        "48": "assets/images/icons/icon_48.png",
        "128": "assets/images/icons/icon_128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "content/lookup_panel.js",
                "shared/*.js",
                "styles/styles.css",
                "styles/lookup_panel.css",
                "fonts/*"
            ],
            "matches": ["<all_urls>"]
        }
    ],
    "permissions": [
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "https://kanjiapi.dev/*",
        "https://kanjiextensionbackend-production.up.railway.app/*"
    ],
    "content_scripts": [
        {
            "resources": ["fonts/*"],
            "matches": ["<all_urls>"],
            "js": [
                "lib/wanakana.min.js", 
                "content/loader.js"
            ]
        }
    ],
    "action": {
        "default_popup": "content/icon_popup.html"
    }
}
